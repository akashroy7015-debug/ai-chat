# Dev defaults. Real providers replace the mocks in src/lib/{age,llm}.
AGE_PROVIDER=mock
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...   (server env only, never commit)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODERATION=true   (free second moderation layer; recommended)
# Romantic-not-explicit is the shipped policy. Do not enable without legal/payments sign-off.
ALLOW_EXPLICIT=false
PAYMENT_PROVIDER=mock
MEDIA_PROVIDER=mock
SAFETY_SCANNER=mock
# MEDIA_ENDPOINT= MEDIA_API_KEY= SAFETY_ENDPOINT= SAFETY_API_KEY=
# EXPLICIT_BLOCKED_COUNTRIES=  (added to the built-in list, which includes IN)
# GRIEVANCE_OFFICER_NAME= GRIEVANCE_OFFICER_EMAIL=
# DB_PATH=./data/app.db
# OPERATOR_NAME=
# ADMIN_EMAILS=you@example.com   (comma separated; these accounts can open /admin)
